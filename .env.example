# ─────────────────────────────────────────────────────────────
# MIDE MEDIA PRODUCTION — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Session signing secret (REQUIRED). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First Super Admin account. Used only to create the first administrator
# when none exists. Change the password afterwards in Admin → Security.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional alternative to ADMIN_PASSWORD: a bcrypt hash
# ADMIN_PASSWORD_HASH=

# Database (libSQL / Turso). Leave empty locally to use ./data/local.db.
# REQUIRED on Vercel. Easiest: Vercel → Storage → connect "Turso" — it sets
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN automatically (both names are supported).
# Or create a database at turso.tech and paste its URL + token here.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# File storage for uploads. REQUIRED on Vercel: create a Blob store
# (Vercel → Storage → Blob) and connect it; Vercel sets this automatically.
# Leave empty locally to store files in ./uploads.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com
